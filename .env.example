# Variables de entorno de la práctica 8 (microservicios).
# El lanzador incidentes-stack rellena las URLs y los puertos.
# Copia este archivo a .env solo si arrancas los servicios a mano.

# --------------------------------------------------------------- servicios
GATEWAY_URL=http://127.0.0.1:8000
CAMERAS_URL=http://127.0.0.1:8001
INFERENCE_URL=http://127.0.0.1:8002
ALERTS_URL=http://127.0.0.1:8003

# Token opcional para POST /internal/eventos. Vacío en local.
INTERNAL_TOKEN=

# Clave opcional del gateway (la PWA la pide en Ajustes).
CENTRAL_API_KEY=

# ------------------------------------------------------- datos por servicio
CAMERAS_DB_PATH=data/cameras.db
ALERTS_DB_PATH=data/alerts.db
# 0 evita que el servicio de cámaras arranque las guardadas.
CAMERAS_AUTOSTART=1

# --------------------------------------------------------------- timeouts
DETECT_TIMEOUT_SEC=8
VERIFY_TIMEOUT_SEC=130
EVENT_TIMEOUT_SEC=2
HTTP_TIMEOUT_SEC=5

# ------------------------------------------------------- detección (etapa 1)
INCIDENTES_MODEL_PATH=yolo11n.pt
INCIDENTES_VIOLENCE_MODEL=violence.pt
INCIDENTES_CONFIDENCE=0.5
INCIDENTES_MOTION_THRESHOLD=12
INCIDENTES_PROXIMITY_FACTOR=0.7

# ------------------------------------------------------ verificación (etapa 2)
INCIDENTES_OLLAMA_MODEL=qwen2.5vl:7b
INCIDENTES_OLLAMA_URL=http://localhost:11434

# ---------------------------------------------------------- pipeline/alerta
INCIDENTES_ALERT_TIMEOUT=5
DISPATCH_WEBHOOK_URL=

# ------------------------------------------------------------------- logging
LOG_LEVEL=INFO
